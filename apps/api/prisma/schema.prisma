// AgentLedger database schema.
// IDs are generated by the API with a type prefix (ws_, usr_, tok_) so they
// match the shared run contract and stay readable in traces and logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ordered from least to most privileged; see src/auth/roles.ts.
enum WorkspaceRole {
  viewer
  reviewer
  editor
  admin
}

model Workspace {
  id          String       @id
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]

  @@map("workspaces")
}

model User {
  id          String       @id
  email       String       @unique
  displayName String       @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  apiTokens   ApiToken[]

  @@map("users")
}

model Membership {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Only the SHA-256 of a token is stored; the plain token is shown once.
model ApiToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  label     String
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}
