// AgentLedger database schema.
// IDs are generated by the API with a type prefix (ws_, usr_, tok_, agt_, agv_, run_) so they
// match the shared run contract and stay readable in traces and logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ordered from least to most privileged; see src/auth/roles.ts.
enum WorkspaceRole {
  viewer
  reviewer
  editor
  admin
}

model Workspace {
  id          String            @id
  slug        String            @unique
  name        String
  createdAt   DateTime          @default(now()) @map("created_at")
  memberships Membership[]
  agents      AgentDefinition[]
  versions    AgentVersion[]
  runs        AgentRun[]

  @@map("workspaces")
}

model User {
  id          String            @id
  email       String            @unique
  displayName String            @map("display_name")
  createdAt   DateTime          @default(now()) @map("created_at")
  memberships Membership[]
  apiTokens   ApiToken[]
  agents      AgentDefinition[]
  versions    AgentVersion[]
  runs        AgentRun[]

  @@map("users")
}

model Membership {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Only the SHA-256 of a token is stored; the plain token is shown once.
model ApiToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  label     String
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// The stable name of an agent inside a workspace. Behaviour lives in versions.
model AgentDefinition {
  id          String         @id
  workspaceId String         @map("workspace_id")
  slug        String
  name        String
  description String?
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions    AgentVersion[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([createdById])
  @@map("agent_definitions")
}

/// An immutable, numbered configuration of an agent. A database trigger
/// rejects UPDATE and DELETE (see the migration), so runs can always point at
/// exactly what was executed.
model AgentVersion {
  id          String          @id
  workspaceId String          @map("workspace_id")
  agentId     String          @map("agent_id")
  version     Int
  config      Json
  /// SHA-256 of the canonical (key-sorted) JSON of `config`.
  configHash  String          @map("config_hash")
  notes       String?
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agent       AgentDefinition @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  runs        AgentRun[]

  @@unique([agentId, version])
  @@unique([id, workspaceId])
  @@unique([id, agentId, workspaceId])
  @@index([workspaceId])
  @@index([createdById])
  @@map("agent_versions")
}

/// Mirrors RunStatusSchema in @agentledger/contracts.
enum RunStatus {
  queued
  running
  paused
  succeeded
  failed
  cancelled
}

enum TimingSource {
  fixture
  measured
}

/// One execution of an exact agent version. The composite foreign key keeps
/// the run, its agent and its version in the same workspace. A trigger (see
/// the migration) only lets `status`, `failure_reason`, `started_at` and
/// `finished_at` change, along the transitions in the run contract, and
/// rejects DELETE.
model AgentRun {
  id             String       @id
  workspaceId    String       @map("workspace_id")
  agentId        String       @map("agent_id")
  agentVersionId String       @map("agent_version_id")
  status         RunStatus    @default(queued)
  timingSource   TimingSource @map("timing_source")
  /// Copied from the version config when the run is created.
  budget         Json
  input          Json
  failureReason  String?      @map("failure_reason")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agentVersion   AgentVersion @relation(fields: [agentVersionId, agentId, workspaceId], references: [id, agentId, workspaceId], onDelete: Restrict)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  traceEvents    TraceEvent[]

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, agentId, createdAt(sort: Desc)])
  @@index([agentVersionId])
  @@index([createdById])
  @@map("agent_runs")
}

/// Mirrors the `type` of TraceEventSchema in @agentledger/contracts.
enum TraceEventType {
  step_started
  step_finished
}

/// One redacted event in a run's trace, numbered per run from 0. Event and step
/// IDs come from the reporter and are unique per run, so replaying a fixture
/// gives the same IDs every time. `data` holds the type-specific fields
/// (index/kind/name/tool/input or status/output/error) after redaction, and
/// `redactions` lists the paths that were removed. A trigger (see the
/// migration) rejects UPDATE and DELETE, and inserts unless the run is
/// running or paused.
model TraceEvent {
  runId       String         @map("run_id")
  sequence    Int
  id          String
  workspaceId String         @map("workspace_id")
  stepId      String         @map("step_id")
  type        TraceEventType
  attempt     Int
  offsetMs    Int            @map("offset_ms")
  data        Json
  redactions  Json
  createdAt   DateTime       @default(now()) @map("created_at")
  run         AgentRun       @relation(fields: [runId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@id([runId, sequence])
  @@unique([runId, id])
  @@index([runId, stepId])
  @@index([workspaceId])
  @@map("trace_events")
}
