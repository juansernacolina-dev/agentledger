// AgentLedger database schema.
// IDs are generated by the API with a type prefix (ws_, usr_, tok_, agt_, agv_) so they
// match the shared run contract and stay readable in traces and logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ordered from least to most privileged; see src/auth/roles.ts.
enum WorkspaceRole {
  viewer
  reviewer
  editor
  admin
}

model Workspace {
  id          String            @id
  slug        String            @unique
  name        String
  createdAt   DateTime          @default(now()) @map("created_at")
  memberships Membership[]
  agents      AgentDefinition[]
  versions    AgentVersion[]

  @@map("workspaces")
}

model User {
  id          String            @id
  email       String            @unique
  displayName String            @map("display_name")
  createdAt   DateTime          @default(now()) @map("created_at")
  memberships Membership[]
  apiTokens   ApiToken[]
  agents      AgentDefinition[]
  versions    AgentVersion[]

  @@map("users")
}

model Membership {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Only the SHA-256 of a token is stored; the plain token is shown once.
model ApiToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  label     String
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// The stable name of an agent inside a workspace. Behaviour lives in versions.
model AgentDefinition {
  id          String         @id
  workspaceId String         @map("workspace_id")
  slug        String
  name        String
  description String?
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions    AgentVersion[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([createdById])
  @@map("agent_definitions")
}

/// An immutable, numbered configuration of an agent. A database trigger
/// rejects UPDATE and DELETE (see the migration), so runs can always point at
/// exactly what was executed.
model AgentVersion {
  id          String          @id
  workspaceId String          @map("workspace_id")
  agentId     String          @map("agent_id")
  version     Int
  config      Json
  /// SHA-256 of the canonical (key-sorted) JSON of `config`.
  configHash  String          @map("config_hash")
  notes       String?
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agent       AgentDefinition @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([agentId, version])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([createdById])
  @@map("agent_versions")
}
