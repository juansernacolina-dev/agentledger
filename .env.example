# Copy to .env and adjust. Never commit .env.
# Local development only; these are not production credentials.

POSTGRES_USER=agentledger
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agentledger
POSTGRES_PORT=5432

REDIS_PORT=6379

# Used by the API and worker (Prisma and BullMQ).
DATABASE_URL=postgresql://agentledger:change-me-local-only@127.0.0.1:5432/agentledger
TEST_DATABASE_URL=postgresql://agentledger:change-me-local-only@127.0.0.1:5432/agentledger_test
REDIS_URL=redis://127.0.0.1:6379

API_PORT=4000
